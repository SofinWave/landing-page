# Raspberry Pi config for the rpi:* mise tasks.
# Copy to .env.rpi on the Pi (gitignored). Every key is optional — sensible
# defaults are baked into docker-compose.rpi.yml and the Dockerfile.

# Host port Caddy publishes; the upstream Cloudflare Tunnel points here.
CADDY_HTTP_PORT=8003

# Note: NEXT_PUBLIC_SITE_URL is baked in at build time (pnpm build), not read
# at runtime — set it as a build arg if you need a domain other than the
# default https://sofinwave.com (see lib/site.ts).

# Multi-site: one Node process serves all four hostnames. Caddy has no host
# matcher and forwards the original Host header through, so nothing changes
# here — but each hostname must be routed to this tunnel:
#
#   sofinwave.com, media.sofinwave.com, finance.sofinwave.com,
#   academy.sofinwave.com
#
# Add each as a public hostname on the Cloudflare Tunnel pointing at the same
# Caddy origin. An unrecognised Host degrades to the apex site rather than 404.
