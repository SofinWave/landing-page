# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/

# Foreign lockfiles. pnpm-lock.yaml is the source of truth; Vercel picks its
# package manager by lockfile and ranks yarn.lock above pnpm-lock.yaml, so a
# stray one hijacks the deploy into yarn with an untested dependency tree.
/yarn.lock
/package-lock.json
/bun.lockb

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but commit example templates
!.env*.example

# mise (commit mise.toml; keep local task/env overrides and secrets out)
.mise.local.toml
mise.local.toml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serena
/.serena/
.superpowers/
