+import { cn } from "@/lib/utils";
+
+export function Section({
+  id,
+  className,
+  children,
+}: {
+  id?: string;
+  className?: string;
+  children: React.ReactNode;
+}) {
+  return (
+    <section id={id} className={cn("container mx-auto px-4 py-16 md:py-24", className)}>
+      {children}
+    </section>
+  );
+}
