+import { useTranslations } from "next-intl";
+import { Section } from "@/components/section";
+
+type Member = { name: string; role: string };
+
+function initials(name: string) {
+  return name.split(" ").map((p) => p[0]).slice(0, 2).join("").toUpperCase();
+}
