#!/usr/bin/env bash
#MISE description="Remove Raspberry Pi containers, locally-built images and volumes"
set -euo pipefail
export COMPOSE_FILE="docker-compose.yml:docker-compose.rpi.yml"
[[ -f .env.rpi ]] && ENV_FILE="--env-file .env.rpi" || ENV_FILE=""
docker compose ${ENV_FILE} down --rmi local -v
